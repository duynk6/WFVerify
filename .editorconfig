# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
# Standard C# formatting
csharp_indent_braces = false
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after

# Code style & Language rules
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_null_propagation = true:suggestion
csharp_style_prefer_null_coalescing_operator = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Naming conventions
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_types
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interface_types.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I

dotnet_naming_rule.private_fields_start_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_start_with_underscore.style = prefix_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.prefix_underscore.capitalization = camel_case
dotnet_naming_style.prefix_underscore.required_prefix = _

# XML / Config / JSON files
[*.{xml,config,props,targets,csproj,sln,json,manifest}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
